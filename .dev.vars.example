# 管理權限改看 Better Auth 的登入角色（admin／super-admin），
# 舊的 ADMIN_PASSWORD 已於 #5 移除，不再有任何程式碼讀取它。

# Better Auth 服務網址與簽章密鑰
# BETTER_AUTH_URL 逐環境不同（本機 http://localhost:5173）；
# BETTER_AUTH_SECRET 與 vTaiwan-hono 共用同一個值。

BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Google OAuth 應用程式憑證
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 應用程式憑證
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Open Router API 應用程式憑證
OPEN_ROUTER_API_KEY=

# 原始碼來源只在 Vite 建置時讀取 shell 環境變數，不是 Worker binding／secret。
# 未設定時由 Git origin 決定。若需覆蓋，請在 shell 或 CI build 環境設定：
# CIVIC_SOURCE_REPOSITORY=https://github.com/example/civic-talk-fork
# 寫成 .dev.vars 的值不會設定這個 build 變數。

# #183 證據 API 開關由各 Wrangler config 控制；一般設定已準備為 1，
# 本機設定不會變更已部署版本；提交／推送／部署須另獲授權。
# reviewer／experiment 也明確為 1；不要在 .dev.vars 定義同名值覆蓋 profile。
# CIVIC_AI_REVIEW=1／CIVIC_AI_EXPERIMENT=1 是啟動 Vite 時擇一設定的 shell 變數，
# 不是 secret；詳見 docs/evidence-api-review.md，不要在本檔同時啟用。
