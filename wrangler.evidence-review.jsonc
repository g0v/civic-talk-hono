{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civic-talk-evidence-review-local-only",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public/", "binding": "ASSETS" },
  "vars": {
    "CIVIC_AI_REVIEW": "1",
    "EVIDENCE_API_ENABLED": "1"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_URL",
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evidence-review-state-local-only",
      "database_id": "00000000-0000-4000-8000-000000090013",
      "remote": false,
      "migrations_dir": "./migrations"
    },
    {
      "binding": "SOURCE_DB",
      "database_name": "evidence-review-source-local-only",
      "database_id": "00000000-0000-4000-8000-000000090025",
      "remote": false,
      "migrations_dir": "./migrations"
    },
    {
      "binding": "DB_AUTH",
      "database_name": "vtaiwan-auth",
      "database_id": "e26edd14-d163-427d-8630-9304f815e9fa",
      "remote": true
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    {
      "binding": "EVIDENCE_WORKFLOW",
      "name": "civic-talk-evidence-review-local",
      "class_name": "EvidenceWorkflow"
    }
  ]
}
