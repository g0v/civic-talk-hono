{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civic-talk",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-17",
  // 刻意不寫死 account_id：與 ../vTaiwan-hono 一致，交給 wrangler 登入的帳號決定
  "assets": { "directory": "./public/", "binding": "ASSETS" },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vtaiwan-civic-talks",
      "database_id": "1b5f4077-f5a7-4b0d-9877-952d5726c7b8",
      "migrations_dir": "./migrations"
    }
  ]
}
