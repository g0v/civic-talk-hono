{
  "name": "civic-talk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp run build:css && vp dev",
    "dev:remote": "vp run build:css && vp dev --mode remote",
    "build:css": "vp exec tailwindcss -i ./src/styles/app.css -o ./public/styles.css",
    "css": "vp exec tailwindcss -i ./src/styles/app.css -o ./public/styles.css",
    "css:watch": "vp exec tailwindcss -i ./src/styles/app.css -o ./public/styles.css --watch",
    "build": "vp run build:css && vp build -c vite.client.config.mts && vp build",
    "preview": "vp preview",
    "deploy": "vp run build && vp exec wrangler deploy",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "check": "vp check",
    "fmt": "vp fmt",
    "cf-typegen": "vp exec wrangler types"
  },
  "dependencies": {
    "@vue/server-renderer": "^3.5.32",
    "better-auth": "^1.6.25",
    "hono": "^4.12.14",
    "markdown-it": "^15.0.0",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/compiler-sfc": "^3.5.32",
    "oxfmt": "^0.59.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "0.2.4",
    "wrangler": "^4.83.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "download"
    }
  }
}
