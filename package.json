{
  "name": "civic-talk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run css && concurrently --kill-others --names css,vite \"npm:css:watch\" \"npm:dev:vite\"",
    "dev:vite": "vite dev",
    "dev:remote": "npm run css && concurrently --kill-others --names css,vite \"npm:css:watch\" \"npm:dev:remote:vite\"",
    "dev:remote:vite": "vite dev --mode remote",
    "css": "tailwindcss -i ./src/styles/app.css -o ./public/styles.css",
    "css:watch": "tailwindcss -i ./src/styles/app.css -o ./public/styles.css --watch",
    "build": "npm run css && vite build -c vite.client.config.mts && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@vue/server-renderer": "^3.5.32",
    "better-auth": "^1.6.25",
    "hono": "^4.12.14",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/compiler-sfc": "^3.5.32",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wrangler": "^4.83.0"
  }
}
